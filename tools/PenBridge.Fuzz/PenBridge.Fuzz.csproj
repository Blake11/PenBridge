<Project Sdk="Microsoft.NET.Sdk">

  <!-- Coverage-guided fuzzing harness for the protocol parsers. Not part of CI; see README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PenBridge.Fuzz</RootNamespace>
    <AssemblyName>penbridge-fuzz</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PenBridge.Core\PenBridge.Core.csproj" />
  </ItemGroup>

</Project>
