<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone: allowBackup="false" does not cover device-to-device transfer on Android 12+.
  The Keystore-wrapped secrets would be unreadable elsewhere anyway; the pairings and settings stay local too.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
