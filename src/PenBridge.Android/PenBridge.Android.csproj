<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.blake11.penbridge</ApplicationId>
    <ApplicationTitle>PenBridge</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RootNamespace>PenBridge.Android</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PenBridge.Core\PenBridge.Core.csproj" />
  </ItemGroup>

  <!--
    QR pairing (ADR-0019): CameraX for the preview/analysis pipeline and ML Kit barcode scanning with the
    bundled model (com.google.mlkit:barcode-scanning, no Play Services dependency at runtime).
    AndroidX Activity gives MainActivity a LifecycleOwner (CameraX), the back dispatcher and the
    runtime-permission contract.
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Activity" VersionOverride="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" VersionOverride="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" VersionOverride="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" VersionOverride="1.6.2" />
    <PackageReference Include="Xamarin.Google.MLKit.BarcodeScanning" VersionOverride="117.3.0.9" />
  </ItemGroup>

</Project>
