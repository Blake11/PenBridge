<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- TLS control channel and UDP input to the Mac. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- NSD discovery of _penbridge._tcp: a multicast lock is held only while browsing. NsdManager itself needs no
       runtime permission (NEARBY_WIFI_DEVICES covers Wi-Fi Direct/Aware/scans, not mDNS); verified on the S23, API 36. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Runtime permission, requested only when the user taps "Scan QR code". -->
  <uses-permission android:name="android.permission.CAMERA" />

  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

  <application
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/PenBridgeTheme">
    <!--
      No third-party telemetry (ADR-0020). ML Kit pulls in Google's datatransport, which batches SDK usage events and
      uploads them to Google (CCT backend). Without its backend discovery service no backend exists, so nothing is
      sent; the scheduler components that would retry uploads go too. Barcode scanning itself runs on-device.
    -->
    <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
    <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
    <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />
  </application>
</manifest>
