<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PenBridge is intentionally NOT sandboxed: posting CGEvents into other apps
  (tablet/mouse injection) is not permitted from the App Sandbox.
-->
<plist version="1.0">
<dict>
    <!-- The .NET runtime JITs; under the hardened runtime (notarization) the VM fails to start without this. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
