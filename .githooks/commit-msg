#!/bin/sh
# Validates the commit subject against Conventional Commits.
# Enabled via: git config core.hooksPath .githooks
#
#   <type>[(<scope>)][!]: <subject>
#
# types:  feat fix refactor perf docs test build ci chore style revert
# scopes: core protocol security input net simclient mac android ios windows ci deps docs spec release (optional)
# The text after ": " must not start with an uppercase letter (as in pr-title.yml).
# Merge, Revert "...", fixup!, squash! and amend! commits are allowed as-is.

msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: message file not found" >&2
    exit 1
fi

# First non-comment, non-empty line.
subject=$(grep -v '^#' "$msg_file" | sed -n '/[^[:space:]]/{p;q;}')

case "$subject" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*)
        exit 0
        ;;
esac

types='feat|fix|refactor|perf|docs|test|build|ci|chore|style|revert'
scopes='core|protocol|security|input|net|simclient|mac|android|ios|windows|ci|deps|docs|spec|release'
pattern="^($types)(\\(($scopes)\\))?!?: [^[:space:]].*"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<MSG
commit-msg: subject is not a Conventional Commit:

    $subject

Expected:  <type>[(<scope>)][!]: <subject>
  types:   ${types}
  scopes:  ${scopes}   (optional)
Examples:  feat(android): stream historical s pen samples
           fix: drop stale udp sequence numbers
See CONTRIBUTING.md.
MSG
    exit 1
fi

len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 100 ]; then
    echo "commit-msg: subject is $len characters; keep it at 100 or fewer." >&2
    exit 1
fi

# Same rule as pr-title.yml (subjectPattern '^(?![A-Z]).+$'): the description after ": " must
# not start with an uppercase ASCII letter. No acronym exception: reword ("CGEvent tap ..." ->
# "the CGEvent tap ..."). pr-title.yml exempts only Dependabot's "Bump ..." PR titles, which never
# pass through this hook.
if printf '%s\n' "$subject" | LC_ALL=C grep -Eq "^($types)(\\(($scopes)\\))?!?: [A-Z]"; then
    cat >&2 <<MSG
commit-msg: the subject must start with a lowercase letter (same rule as the PR title check):

    $subject

Example:   fix(mac): keep the tablet mapping after a display change
MSG
    exit 1
fi

exit 0
