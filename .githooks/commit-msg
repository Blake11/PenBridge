#!/bin/sh
# Validates the commit subject against Conventional Commits.
# Enabled via: git config core.hooksPath .githooks
#
#   <type>[(<scope>)][!]: <subject>
#
# types:  feat fix refactor perf docs test build ci chore style revert
# scopes: core mac android ios protocol ci deps docs (optional)
# Merge, Revert "...", fixup!, squash! and amend! commits are allowed as-is.

msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: message file not found" >&2
    exit 1
fi

# First non-comment, non-empty line.
subject=$(grep -v '^#' "$msg_file" | sed -n '/[^[:space:]]/{p;q;}')

case "$subject" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*)
        exit 0
        ;;
esac

types='feat|fix|refactor|perf|docs|test|build|ci|chore|style|revert'
scopes='core|mac|android|ios|protocol|ci|deps|docs'
pattern="^($types)(\\(($scopes)\\))?!?: [^[:space:]].*"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<MSG
commit-msg: subject is not a Conventional Commit:

    $subject

Expected:  <type>[(<scope>)][!]: <subject>
  types:   ${types}
  scopes:  ${scopes}   (optional)
Examples:  feat(android): stream historical s pen samples
           fix: drop stale udp sequence numbers
See CONTRIBUTING.md.
MSG
    exit 1
fi

len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 100 ]; then
    echo "commit-msg: subject is $len characters; keep it at 100 or fewer." >&2
    exit 1
fi

if printf '%s\n' "$subject" | grep -Eq "^[a-z]+(\\([a-z]+\\))?!?: [A-Z]"; then
    echo "commit-msg: warning: subject should start with a lowercase letter." >&2
fi

exit 0
