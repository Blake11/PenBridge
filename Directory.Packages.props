<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Android head: CameraX + ML Kit (bundled model) for QR pairing; AndroidX Activity for the activity host. -->
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
    <PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.9" />
  </ItemGroup>
</Project>
