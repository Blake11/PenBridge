# Single source of truth for the Apple toolchain pairing in CI and release builds.
# The macos/ios workload packs refuse any Xcode but their own major.minor, and an unpinned
# workload set moves on its own, so both are pinned here and bumped together, by hand:
#   1. pick the workload set (`dotnet workload search version`) and the Xcode it names
#      ("requires Xcode X.Y" in the build error),
#   2. check the runner image ships that Xcode (actions/runner-images xcode-27 README),
#   3. verify with a CI run and a build-release dry run.
# Read by .github/actions/select-xcode and .github/actions/dotnet-workload.
WORKLOAD_SET=10.0.402
XCODE_VERSION=27.0
